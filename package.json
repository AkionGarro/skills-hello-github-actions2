{
  "name": "skills-hello-github-actions2",
  "version": "1.0.0",
  "description": "A demo Node.js app showcasing GitHub Actions CI/CD features",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "echo \"Build step: copying files...\" && mkdir -p dist && cp src/index.js dist/index.js && echo \"Build complete. Output in ./dist\"",
    "test": "jest --coverage",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
